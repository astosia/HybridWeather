      {
        "type": "input",
        "messageKey": "LocationQuery",
        "label": "Location",
        "description": "Start typing a city, place name or postcode/zipcode, then pick from the list. Leave blank to use your phone's GPS location for weather and sunrise & sunset times. Location search data from ©OpenStreetMap (Photon) and GeoNames (Open-Meteo)",
        "attributes": {
          "placeholder": "e.g. London, UK (leave empty to use GPS)"
        }
      },
      {
        "type": "input",
        "messageKey": "Lat",
